# Nookipedia API key
# Only needed to refresh the data in public/data (npm run fetch-data).
# The site itself does not call the API, so no key is shipped to the browser.
#
# Steps:
# 1. Copy this file: cp env.example .env.local (or copy manually)
# 2. Replace 'your_api_key_here' with your key from https://api.nookipedia.com

NOOKIPEDIA_API_KEY=your_api_key_here
